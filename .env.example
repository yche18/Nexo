# Nexo 环境变量
# docker compose 部署时自动读取，后端通过 env_file 接收此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=nexo-local-password
# Docker 内部地址；Compose 使用上面的密码生成并覆盖此地址
REDIS_URL=redis://:nexo-local-password@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时使用）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# ── Nexo 宿主机端口（与容器内部端口区分）────────────────────────────────────────
BACKEND_PORT=18000
FRONTEND_PORT=18080
REDIS_PORT=16379
CHROMA_EXTERNAL_PORT=18001
PROMETHEUS_WEB_PORT=19090
NGINX_PORT=18081
