# Nexo 环境变量
# docker compose 部署时自动读取，后端通过 env_file 接收此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# false 显式关闭思考；留空或删除此项时不发送 thinking 参数，使用服务商默认行为。
LLM_THINKING_ENABLED=false

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=nexo-local-password
# Docker 内部地址；Compose 使用上面的密码生成并覆盖此地址
REDIS_URL=redis://:nexo-local-password@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时使用）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# ── Nexo 宿主机端口（与容器内部端口区分）────────────────────────────────────────
BACKEND_PORT=18000
FRONTEND_PORT=18080
REDIS_PORT=16379
CHROMA_EXTERNAL_PORT=18001
PROMETHEUS_WEB_PORT=19090
NGINX_PORT=18081

# RAG 混合检索：ES 与 Chroma 使用同一份片段；首次升级请显式重建关键词索引。
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=nexo_knowledge
ELASTICSEARCH_EXTERNAL_PORT=19200
RAG_CANDIDATE_K=20
RAG_RRF_K=60
RAG_NEIGHBOR_WINDOW=1
RAG_EXPANSION_SEEDS=3
# 包含证据 metadata 的 JSON 字符预算，不是精确 token 数。
RAG_EVIDENCE_MAX_CHARS=8000
# 完整 /rerank 端点；留空时保留 RRF 排序，trace 标记 disabled。
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=8

# Agent Harness: observe records checks without extra model calls or answer changes.
NEXO_HARNESS_MODE=observe
NEXO_HARNESS_VERIFY_VPN=true
NEXO_HARNESS_VALIDATION_TIMEOUT=60
NEXO_HARNESS_MAX_TOOL_CALLS=12

# Local demo tickets (enforce only). Compose overrides this with its named-volume path.
NEXO_TICKET_DB_PATH=./data/tickets/tickets.sqlite3
