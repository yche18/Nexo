      "name": "办公设备配置咨询",
      "turns": [
        {
          "message": "我需要配置办公室打印机，请指导一下。",
          "agent_in": [
            "general"
          ]
        },
        {
          "message": "使用 Windows 电脑，打印机已经连上公司内网。"
        },
        {
          "message": "请列出我接下来应该操作的步骤。",
