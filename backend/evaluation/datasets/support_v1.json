            "打印机"
          ]
        }
      ]
    },
    {
      "id": "d02",
      "split": "dev",
      "name": "登录故障信息交接",
      "turns": [
        {
          "message": "VPN 登录失败，提示错误码 401。",
          "agent_in": [
            "technical"
          ]
        },
        {
          "message": "目标系统：VPN；问题现象：登录失败；错误码：401。退出重新登录后仍然一样。"
        },
        {
          "message": "那请转人工 IT 支持处理。",
          "agent_in": [
            "escalation"
          ],
          "not_contains": [
            "近期会话",
            "**助手：**",
            "**用户：**"
          ],
          "fields": {
            "目标系统": [
              "VPN"
            ],
            "错误码": [
              "401"
            ]
          }
        }
      ]
    },
